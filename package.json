{
  "name": "bollfile",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/renderer/main.tsx --bundle --format=iife --jsx=automatic --outfile=dist/renderer/renderer.js && node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer',{recursive:true});fs.cpSync('src/renderer/index.html','dist/renderer/index.html');fs.cpSync('src/renderer/fonts','dist/renderer/fonts',{recursive:true});\"",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "cli": "npm run build && node dist/cli.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/",
    "pack:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "dht-rpc": "^6.27.0",
    "hyperswarm": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.bollfile.app",
    "productName": "bollfile",
    "copyright": "Copyright © 2026 bollfile",
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/test/**",
      "!dist/test-support/**"
    ],
    "asarUnpack": ["**/*.node", "**/prebuilds/**"],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["zip", "dir"]
    }
  }
}
